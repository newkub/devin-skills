{
  "name": "@analyze-codebase-quality/shared",
  "version": "0.1.0",
  "description": "Shared types and utilities for analyze-codebase-quality",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bunx bunup --watch",
    "build": "bunx bunup",
    "lint": "bunx biome lint src/",
    "lint:fix": "bunx biome lint --write src/",
    "format": "bunx biome format --write src/",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "bunup": "^0.16.32",
    "@biomejs/biome": "^2.5.2",
    "typescript": "^6.0.3",
    "bun-types": "^1.3.14"
  }
}
