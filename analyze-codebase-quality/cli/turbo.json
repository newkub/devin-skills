{
  "$schema": "https://turbo.com/schema.json",
  "tasks": {
    "build": {
      "inputs": ["src/**", "package.json", "tsconfig.json", "bunup.config.ts"],
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["src/**", "biome.jsonc", "package.json"],
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "inputs": ["src/**", "biome.jsonc", "package.json"],
      "outputs": [],
      "cache": false
    },
    "format": {
      "inputs": ["src/**", "biome.jsonc", "package.json"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": [],
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "inputs": ["src/**", "test/**", "package.json"],
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"],
      "cache": false
    },
    "verify": {
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "biome.jsonc"],
      "outputs": [],
      "dependsOn": ["typecheck", "lint", "test", "build"],
      "cache": false
    },
    "ci": {
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "biome.jsonc"],
      "outputs": ["dist/**"],
      "dependsOn": ["verify"],
      "cache": false
    }
  }
}
