{
  "name": "analyze-codebase-quality",
  "version": "0.1.0",
  "description": "Analyze codebase quality across all dimensions - structure, foundation, runtime, UX, localization, features, errors, and missing implementation",
  "keywords": [
    "codebase",
    "analysis",
    "quality",
    "cli",
    "ast-grep",
    "static-analysis"
  ],
  "author": "Wrikka",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkub/analyze-codebase-quality.git"
  },
  "homepage": "https://github.com/newkub/analyze-codebase-quality#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "bin": {
    "analyze-codebase-quality": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "bunx bunup --watch",
    "build": "bunx bunup",
    "lint": "bunx biome lint src/",
    "lint:fix": "bunx biome lint --write src/",
    "format": "bunx biome format --write src/",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "start": "bun run dist/cli.js",
    "release": "bun run dist/cli.js",
    "prerelease": "bun run build",
    "publish": "npm publish --access public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.0",
    "bunup": "^0.16.32",
    "bun-types": "^1.3.0",
    "typescript": "^5.8.0"
  }
}
