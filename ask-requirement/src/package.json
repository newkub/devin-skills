  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "bun@1.3.13",
  "trustedDependencies": ["turbo"],
  "workspaces": [
    "apps/*",
    "packages/*"
