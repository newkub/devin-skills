{
  "name": "ask-requirement",
  "private": true,
  "type": "module",
  "description": "Structured project requirement collection tool with CLI, Web UI, and MCP server",
  "license": "MIT",
  "author": "newkub",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkub/ask-requirement"
  },
  "homepage": "https://github.com/newkub/ask-requirement#readme",
  "bugs": {
    "url": "https://github.com/newkub/ask-requirement/issues"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome lint .",
