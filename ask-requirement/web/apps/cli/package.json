{
  "name": "@ask-requirement/cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ask-requirement": "./dist/index.js"
  },
  "description": "Interactive CLI tool for collecting structured project requirements via MCP",
  "license": "MIT",
  "author": "newkub",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkub/ask-requirement",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/newkub/ask-requirement#readme",
  "bugs": {
    "url": "https://github.com/newkub/ask-requirement/issues"
  },
  "keywords": ["cli", "requirement", "mcp", "project", "ai", "bun"],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "verify": "bun run typecheck && bun run lint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ask-requirement/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/bun": "^1.3.14"
  }
}
