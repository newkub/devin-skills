{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "jsxImportSource": "solid-js",
    "moduleResolution": "bundler",
    "target": "ES2022"
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "uno.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output"
  ]
}