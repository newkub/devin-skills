{
  "name": "@ask-requirement/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Shared types, Zod schemas, and summary generator for ask-requirement",
  "license": "MIT",
  "author": "newkub",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkub/ask-requirement",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/newkub/ask-requirement#readme",
  "bugs": {
    "url": "https://github.com/newkub/ask-requirement/issues"
  },
  "keywords": ["shared", "types", "zod", "schema", "requirement"],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "verify": "bun run typecheck && bun run lint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/bun": "^1.3.0"
  }
}
