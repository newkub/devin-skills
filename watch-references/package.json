{
  "name": "watch-references",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Continuously running reference intelligence for coding agents",
  "bin": {
    "watch-ref": "./src/cli.ts"
  },
  "scripts": {
    "scan": "bun src/cli.ts scan",
