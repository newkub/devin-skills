{
  "name": "review-dot-agents-global-and-fix",
  "version": "2.0.0",
  "description": "Review the agents harness at ~/.agents for frontmatter, sections, style, line count, references, and cross-skill consistency",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "review": "bun run src/index.ts",
    "review:repo": "bun run src/index.ts \"%USERPROFILE%\\.agents\\skills\"",
    "review:fix": "bun run src/index.ts --fix",
    "review:ci": "bun run src/index.ts --ci",
    "review:refs": "bun run src/broken-skills-references.ts"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
